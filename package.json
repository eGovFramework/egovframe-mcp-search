{
  "name": "egovframe-mcp-search",
  "version": "1.0.0",
  "description": "eGovFrame MCP server exposing two tools: egov_search_knowledge (unified read-only search over official guides, personal knowledge, standard terms, common components, and compatible software) and egov_ddl_assist (standard-term DDL design oracle). Backed by one local hybrid (SQLite + LanceDB) store.",
  "private": true,
  "type": "module",
  "bin": {
    "egovframe-mcp-search": "./build/index.js"
  },
  "files": [
    "build",
    "templates/common-components-src",
    "knowledge-base",
    "models"
  ],
  "engines": {
    "node": ">=20"
  },
  "bundleDependencies": true,
  "keywords": [
    "egovframe",
    "mcp",
    "knowledge-base",
    "rag",
    "ai-assistant",
    "search"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\" && tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "prepare": "npm run build",
    "pack:platforms": "bash scripts/pack-platforms.sh",
    "fetch-model": "node scripts/fetch-model.mjs",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "build-index": "node build/scripts/buildIndex.js",
    "build-index:custom": "npm run build && node build/scripts/buildCustomIndex.js",
    "test": "npm run build && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.22.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.0",
    "apache-arrow": "18.1.0",
    "better-sqlite3": "^12.11.1",
    "csv-parse": "^6.2.1",
    "fs-extra": "^11.2.0",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  }
}
